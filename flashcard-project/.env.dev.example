# Copy to .env.dev (git-ignored) for `python dev/miniapp_dev.py`. Dev values only: never production or pilot.
# The runner reads only this file, never .env. Only the first word of a token is used.

# it or en: picks the shadow bot below
KARTINO_DEV_LANGUAGE=en
# Shadow bots: dev/test bots made with @BotFather, never production. The chosen one signs the Mini App's
# init data and, in tunnel mode, runs the bot.
KARTINO_EN_SHADOW_BOT_TOKEN=
KARTINO_IT_SHADOW_BOT_TOKEN=
# Production bot ids (the digits before ':' in their tokens; not secret), comma-separated. A shadow token
# with one of these ids is refused. Required for tunnel mode.
KARTINO_PROD_BOT_IDS=
# Your Telegram user id, the dev user
KARTINO_DEV_USER_ID=
# Groq key for card generation
KARTINO_DEV_GROQ_KEY=

# Optional
# KARTINO_DEV_GROQ_MODEL=openai/gpt-oss-20b
# Loopback only; the runner refuses any other host.
# KARTINO_DEV_MONGO_URI=mongodb://127.0.0.1:27019/?directConnection=true
# KARTINO_DEV_MONGO_DB=kartino_dev_en
