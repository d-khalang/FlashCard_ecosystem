# ──────────────────────────────────────────────
# Telegram Bots
# ──────────────────────────────────────────────
BOT_TOKEN=your_main_bot_token
LOGGER_BOT_TOKEN=your_logger_bot_token
ADMIN_ID=123456789
TELEGRAM_DELIVERY_MODE=polling

# ──────────────────────────────────────────────
# Webhook (only needed in webhook mode)
# ──────────────────────────────────────────────
WEBHOOK_BASE=https://bot.${DOMAIN}
WEBHOOK_PATH=/webhook/telegram/replace-with-random-token
WEBHOOK_SECRET=your_webhook_secret

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=flashcard_db
COLLECTION_USERS=users
COLLECTION_EXPRESSION=expressions
COLLECTION_CONJUGATION=conjugations
MONGO_INITDB_ROOT_USERNAME=secure_user
MONGO_INITDB_ROOT_PASSWORD=secure_password

# ──────────────────────────────────────────────
# WR Scraper Service
# ──────────────────────────────────────────────
SCRAPER_API_KEY=your_scraper_api_key
SCRAPER_URL=http://wr-scraper
SCRAPER_PORT=8000

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
PORT=8000
IN_DOCKER=0
LOG_LEVEL=INFO
SCHEDULER_CHECK_INTERVAL_SECONDS=600

# ──────────────────────────────────────────────
# Caddy / TLS
# ──────────────────────────────────────────────
ACME_EMAIL=you@example.com

# ──────────────────────────────────────────────
# Domain
# ──────────────────────────────────────────────
DOMAIN=example.com
