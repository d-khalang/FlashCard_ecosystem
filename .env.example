# ──────────────────────────────────────────────
# Telegram Bots
# ──────────────────────────────────────────────
BOT_TOKEN=your_main_bot_token
LOGGER_BOT_TOKEN=your_logger_bot_token
ADMIN_ID=123456789
TELEGRAM_DELIVERY_MODE=polling

# ──────────────────────────────────────────────
# Webhook (only needed in webhook mode)
# ──────────────────────────────────────────────
WEBHOOK_BASE=https://bot.${DOMAIN}
WEBHOOK_PATH=/webhook/telegram/replace-with-random-token
WEBHOOK_SECRET=your_webhook_secret

# ──────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=flashcard_db
COLLECTION_USERS=users
COLLECTION_EXPRESSION=expressions
COLLECTION_CONJUGATION=conjugations
MONGO_INITDB_ROOT_USERNAME=secure_user
MONGO_INITDB_ROOT_PASSWORD=secure_password

# ──────────────────────────────────────────────
# WR Scraper Service
# ──────────────────────────────────────────────
SCRAPER_API_KEY=your_scraper_api_key
SCRAPER_URL=http://wr-scraper
SCRAPER_PORT=8000

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
PORT=8000
IN_DOCKER=0
LOG_LEVEL=INFO
LEARNING_LANGUAGE_CODE=it
LEARNING_LANGUAGE_NAME=Italian
LEARNING_LANGUAGE_FLAG=🇮🇹
DEFAULT_PRIMARY_LANGUAGE=en
DEFAULT_SECONDARY_LANGUAGE=
DEFAULT_TARGET_LEVEL=A2
UI_LOCALE=en
ENABLE_CONJUGATION=True
LANGUAGE_VALIDATOR=auto
SCHEDULER_CHECK_INTERVAL_SECONDS=600
LLM_GOOGLE_MODEL=gemini-2.5-flash-lite
LLM_GROQ_MODEL=openai/gpt-oss-120b
LLM_GROQ_FALLBACK_DELAY_SECONDS=3.0
LLM_MAX_ATTEMPTS=2

# ──────────────────────────────────────────────
# Quota / Tier Limits
# ──────────────────────────────────────────────
TIER_LIMITS_NORMAL_CARDS=10
TIER_LIMITS_NORMAL_STORIES=2
TIER_LIMITS_DIGI_CARDS=40
TIER_LIMITS_DIGI_STORIES=3
TIER_LIMITS_PLUS_CARDS=50
TIER_LIMITS_PLUS_STORIES=10
TIER_LIMITS_ADMIN_CARDS=999
TIER_LIMITS_ADMIN_STORIES=99

# ──────────────────────────────────────────────
# Caddy / TLS
# ──────────────────────────────────────────────
ACME_EMAIL=you@example.com

# ──────────────────────────────────────────────
# Domain
# ──────────────────────────────────────────────
DOMAIN=example.com
