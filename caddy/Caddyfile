{
    # Set ACME_EMAIL in your server env for certificate notices.
    email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
    encode zstd gzip
    root * /srv/web
    file_server
}

app.{$DOMAIN} {
    encode zstd gzip
    respond "Mini app is not deployed yet." 200
}

bot.{$DOMAIN} {
    encode zstd gzip

    @webhook path /webhook/*
    reverse_proxy @webhook flashcard-bot:8000

    @health path /health
    reverse_proxy @health flashcard-bot:8000

    respond 404
}
