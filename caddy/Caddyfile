bot.kartino.it {
    encode zstd gzip

    @bot_health path /health
    reverse_proxy @bot_health flashcard-bot:8000

    @bot_webhook path /webhook/*
    reverse_proxy @bot_webhook flashcard-bot:8000

    respond 404
}
