{
    # Set ACME_EMAIL in your server env for certificate notices.
    email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
    encode zstd gzip
    root * /srv/web
    file_server
}

app.{$DOMAIN} {
    encode zstd gzip
    respond "Mini app is not deployed yet." 200
}

bot.{$DOMAIN} {
    encode zstd gzip

    @telegram_webhook {
        method POST
        path {$WEBHOOK_PATH}
    }
    handle @telegram_webhook {
        reverse_proxy flashcard-bot:8000
    }

    handle /health {
        reverse_proxy flashcard-bot:8000
    }

    handle {
        respond 404
    }
}

